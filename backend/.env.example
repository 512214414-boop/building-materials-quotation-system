# ===== 数据库（请改为你本地的 MySQL 连接）=====
DATABASE_URL="mysql://root:root@localhost:3306/bm_quotation"

# ===== 鉴权 =====
JWT_SECRET="change-me-to-a-random-32-char-secret-string"
JWT_EXPIRES_IN="8h"
CUSTOMER_TOKEN_EXPIRES_IN="24h"

# ===== 服务 =====
PORT=3000
NODE_ENV="development"

# ===== 上传 =====
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="jpg,jpeg,png,webp"

# ===== 限流 =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ===== 授权码默认有效期（小时）=====
AUTH_CODE_EXPIRES_HOURS=24

# ===== AI 识单（可选；未配置时文本走规则拆分）=====
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ===== WebSocket（核心配置硬编码，此处仅周期与路径可覆盖）=====
WS_PATH="/ws"
WS_HEARTBEAT_MS=30000
