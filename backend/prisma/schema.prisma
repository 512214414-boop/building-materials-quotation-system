// ============================================================
// 枚举定义
// ============================================================

enum coord_source {
  geocoded
  manual
}

enum user_status {
  active
  disabled
}

enum customer_status {
  active
  disabled
}

// v25：客户类型改为 customer_type 字典表，不再用 enum
// v1.7.1 移除：客户分级 customer_level

enum supplier_status {
  active
  inactive
}

enum supplier_type {
  external
  warehouse
}

enum rounding_rule {
  ceil
  round
  floor
}

enum document_status {
  demand_pending
  quote_confirmed
  payment_settled
  allocation_in_progress
  delivery_completed
  cost_verified
  after_sales
  archived
}

enum stage_status {
  pending
  confirmed
  voided
}

enum payment_type {
  deposit
  final
  balance
}

enum reconcile_status {
  pending
  reconciled
}

enum delivery_method {
  self_pickup
  haulage
  special_van
  logistics
  site_delivery
}

enum delivery_status {
  pending
  shipped
  signed
}

enum cost_channel_type {
  warehouse
  supplier
}

/// v1.7.0：成本分层段（配货·成本推演方案 §5.4）
///   internal：内部仓库出库（单价=当前仓库加权平均进价）
///   external_agreed：外部刚需直发（单价=该供应商本次约定进价）
///   external_excess：外部超额入库（单价=约定进价，不计订单成本，入库时计入库存）
enum cost_segment {
  internal
  external_agreed
  external_excess
}

enum allocation_pending_status {
  allocated
  pending
}

enum refund_type {
  refund
  exchange
}

enum archive_status {
  working
  archived
  revoked
}

enum refund_status {
  pending
  closed
}

/// v1.7.0：库存流水变动类型（入 / 出 / 盘点调整）
enum inventory_movement_type {
  in
  out
  adjust
}

/// v1.7.0：欠库台账状态（待补 / 已补 / 已取消）
enum backorder_status {
  pending
  fulfilled
  cancelled
}

/// v1.7.0：待入库单状态（待确认 / 已入库 / 已取消）
enum inbound_task_status {
  pending
  done
  cancelled
}

/// v1.7.0：供应商应付状态（未结算 / 已结算）
enum payable_status {
  pending
  settled
}
