  confirmed_by   BigInt?
  confirmedName  String?             @db.VarChar(50)
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  lines          purchase_inbound_lines[]

  @@index([status, created_at])
  @@index([supplier_id])
  @@index([warehouse_id])
  @@map("purchase_inbounds")
}

model purchase_inbound_lines {
  id           BigInt   @id @default(autoincrement())
  inbound_id   BigInt
  spec_id      BigInt
  brand_id     BigInt
  unit_id      BigInt
  productName  String?  @db.VarChar(200)
  specModel    String?  @db.VarChar(200)
  brandName    String?  @db.VarChar(100)
  categoryName String?  @db.VarChar(100)
  unitName     String?  @db.VarChar(50)
  qty          Decimal  @db.Decimal(14, 3)
