}

/// 欠库台账（v1.7.0 新增，v14.0 SKU 升级为 规格×品牌×单位，库存不足兜底：边接单边补货）
/// 内部出库库存不足时，已有库存全额扣除，缺口挂欠库；补货入库后自动冲抵
model backorders {
  id             BigInt   @id @default(autoincrement())
  /// 欠库来源订单（无物理外键）
  document_id    BigInt
  /// 欠库来源单据行
  line_id        BigInt
  /// 欠库仓库
  warehouse_id   BigInt
  /// SKU 维度：规格变体 ID（v14.0 新增，v14.0.1：物理层面 NOT NULL，空缺由系统兜底 0=未关联规格填充）
  spec_id        BigInt
  /// SKU 维度：品牌 ID
  brand_id       BigInt
  unit_id        BigInt
  /// 欠库数量（缺口）
  qty            Decimal  @db.Decimal(14, 3)
  /// 状态：待补 / 已补 / 已取消
  status         backorder_status @default(pending)
  fulfilled_at   DateTime?
  fulfilled_by   BigInt?
  /// 冲抵操作人名称快照
  fulfilledName  String?  @db.VarChar(50)
  note           String?  @db.VarChar(500)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([status])
  @@index([document_id])
  @@index([warehouse_id, spec_id, brand_id, unit_id])
  @@map("backorders")
}

/// 交付履约视图标注
model delivery_records {
  id              BigInt          @id @default(autoincrement())
  document_id     BigInt
  delivery_method delivery_method
  tracking_no     String?         @db.VarChar(100)
  receiver        String?         @db.VarChar(100)
  receiver_phone  String?         @db.VarChar(20)
  status          delivery_status @default(pending)
  shipped_at      DateTime?
  signed_at       DateTime?
  attachment_urls Json?
  note            String?         @db.Text
  freight         Decimal         @default(0) @db.Decimal(14, 2)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  document documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id])
  @@index([status])
  @@map("delivery_records")
}

/// 成本核定视图标注（内部进货成本，与 document_lines.unit_price 物理隔离）
/// v1.7.0 成本分层落账（配货·成本推演方案 §5.4 / §9.7）：
///   - 配货确认时按分层口径写入：internal（内部出库）/ external_agreed（外部刚需）/ external_excess（外部超额）
///   - 分层单价系统锁定（internal=加权平均进价 / external_*=约定进价），用户仅可调整 actual_cost/freight/remark
///   - external_excess 段入库确认后回填 inbound_line_id（追溯锚点）
model cost_lines {
  id               BigInt            @id @default(autoincrement())
  line_id          BigInt
  /// v1.7.0 成本分层段（内部出库 / 外部刚需 / 外部超额）
  cost_segment     cost_segment
  /// 通道类型（派生：internal→warehouse / external_*→supplier，兼容既有展示）
  channel_type     cost_channel_type
  source_id        BigInt
  /// v11.0 解耦：供应商名称快照（来自 supplier.name）
  sourceName       String?           @db.VarChar(200)
  preset_unit_cost Decimal           @default(0) @db.Decimal(14, 2)
  actual_cost      Decimal           @default(0) @db.Decimal(14, 2)
  cost_adjust      Decimal           @default(0) @db.Decimal(14, 2)
  freight          Decimal           @default(0) @db.Decimal(14, 2)
  cost_qty         Decimal           @db.Decimal(14, 3)
  /// v1.7.0 外部超额量（external_excess 段 = 超额量，其余段 0）
  over_qty         Decimal           @default(0) @db.Decimal(14, 3)
  /// v1.7.0 关联待入库行（external_excess 段，确认入库后回填）
  inbound_line_id  BigInt?
  cost_amount      Decimal           @default(0) @db.Decimal(14, 2)
  remark           String?           @db.Text
  verified_by      BigInt?
  /// v11.0 解耦：核销人名称快照（来自 users.real_name）
  verifierName     String?           @db.VarChar(50)
  verified_at      DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  document_line document_lines @relation(fields: [line_id], references: [id], onDelete: Cascade)
  // v11.0 解耦：移除 source → supplier / verifier → users 的 @relation 物理外键约束
  // 保留 source_id / verified_by BigInt? 字段与索引，档案删除时成本行仍可正常展示

  // v1.7.0 分层唯一约束：同一行内 段 + 来源 唯一（外部来源可同时存在 external_agreed / external_excess 两段）
  @@unique([line_id, cost_segment, source_id])
  @@index([line_id])
  @@index([source_id])
  @@index([cost_segment])
  @@map("cost_lines")
}

/// 退换售后视图标注（强制继承原单基准数据）
model refund_lines {
  id             BigInt        @id @default(autoincrement())
  line_id        BigInt
  refund_type    refund_type
  original_qty   Decimal       @db.Decimal(12, 2)
  original_price Decimal       @db.Decimal(14, 2)
  refund_qty     Decimal       @db.Decimal(12, 2)
  refund_amount  Decimal       @db.Decimal(14, 2)
  refund_status  refund_status @default(pending)
  refund_at      DateTime?
  reason         String?       @db.Text
  restock        Boolean       @default(false)
  restock_warehouse_id BigInt?
  created_by     BigInt?
  /// v11.0 解耦：创建者名称快照（来自 users.real_name）
  creatorName    String?       @db.VarChar(50)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  document_line document_lines @relation(fields: [line_id], references: [id], onDelete: Cascade)
  // v11.0 解耦：移除 creator → users 的 @relation 物理外键约束
  // 保留 created_by BigInt? 字段与索引，员工档案删除时退款行仍可正常展示

  @@index([line_id])
  @@index([refund_type])
  @@index([refund_status])
  @@map("refund_lines")
}

